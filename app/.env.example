# Скопируйте в .env ВНЕ публичной папки. Никогда не добавлять .env в GitLab.
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENABLE_DEMO_LOGIN=false
# SMTP с обязательным TLS: порт 465 SSL или 587 STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# OpenRouter: только :free модель. Нет переключения на платный API.
OCR_API_KEY=
OCR_MODEL=qwen/qwen2.5-vl-32b-instruct:free
# setup_hosting.py генерирует ключи Web Push. Требуется cron раз в минуту.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:webmaster@naumenkoilia.ru
