# Development defaults. Production: keep this file outside the checkout and public directory;
# select it with PETCARE_ENV_FILE=/etc/petcare/runtime.env, permissions 0600.
APP_ENV=development

# Enable only after seller terms are published and the YooKassa shop is connected.
YOOKASSA_ENABLED=false
YOOKASSA_TEST=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PETCARE_SELLER_NAME=
PETCARE_SELLER_INN=
PETCARE_SELLER_EMAIL=
PETCARE_SELLER_PHONE=
PETCARE_SELLER_ADDRESS=
PETCARE_SELLER_TERMS=
DATABASE_URL=postgresql+psycopg://petcare_app:CHANGE_ME@127.0.0.1:5432/petcare
SECRET_KEY=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ENABLE_DEMO_LOGIN=false
# Optional administrator alias. Configure privately on the server.
ADMIN_LOGIN=
# SMTP с обязательным TLS: порт 465 SSL или 587 STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Google AI Studio: проект Free tier БЕЗ подключённого Cloud Billing.
# Подписка Google AI Pro не заменяет тариф API. Нет автоматической подмены модели.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# setup_hosting.py генерирует ключи Web Push. Требуется cron раз в минуту.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:webmaster@naumenkoilia.ru

# Never put MIGRATION_DATABASE_URL or backup/storage credentials in the web environment.
# Production requires a generated SECRET_KEY, disabled demo login and data-only DB role.

# Canonical HTTPS origin for public pages and sitemap generation.
PUBLIC_SITE_URL=
