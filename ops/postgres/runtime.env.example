# Install as /etc/petcare/runtime.env, owned by web service user, mode 0600.
APP_ENV=production
SECRET_KEY=GENERATE_A_NEW_RANDOM_SECRET_KEEP_EXISTING_KEY_ON_UPGRADE
DATABASE_URL=postgresql+psycopg://petcare_app:CHANGE_ME@db.internal:5432/petcare?sslmode=verify-full&sslrootcert=/etc/petcare/ca.crt
ALLOWED_HOSTS=petcare.example
ENABLE_DEMO_LOGIN=false
# SMTP/OCR/VAPID runtime settings go here. No migrator or backup credentials.
