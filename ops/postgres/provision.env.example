# Run once with a dedicated database administrator; keep outside the checkout, mode0600.
APP_ENV=production
PROVISION_DATABASE_URL=postgresql+psycopg://database_admin:CHANGE_ME@db.internal:5432/petcare?sslmode=verify-full&sslrootcert=/etc/petcare/ca.crt
PG_APP_SCHEMA=petcare
PG_APP_USER=petcare_app
PG_APP_PASSWORD=GENERATE_AT_LEAST_24_RANDOM_CHARACTERS
PG_MIGRATOR_USER=petcare_migrator
PG_MIGRATOR_PASSWORD=GENERATE_ANOTHER_RANDOM_PASSWORD
PG_BACKUP_USER=petcare_backup
PG_BACKUP_PASSWORD=GENERATE_ANOTHER_RANDOM_PASSWORD
