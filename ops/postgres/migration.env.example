# Separate deployment credential. Never load this file into the web process.
APP_ENV=production
MIGRATION_DATABASE_URL=postgresql+psycopg://petcare_migrator:CHANGE_ME@db.internal:5432/petcare?sslmode=verify-full&sslrootcert=/etc/petcare/ca.crt
# No SECRET_KEY or web session signing key is required by Alembic/import tooling.
