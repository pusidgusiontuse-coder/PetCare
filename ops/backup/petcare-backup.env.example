APP_ENV=production
BACKUP_DATABASE_URL=postgresql+psycopg://petcare_backup:CHANGE_ME@db.internal:5432/petcare?sslmode=verify-full&sslrootcert=/etc/petcare/ca.crt
PG_APP_SCHEMA=petcare
RESTIC_REPOSITORY=s3:https://storage.example/PRIVATE_BUCKET/petcare
RESTIC_PASSWORD_FILE=/etc/petcare/restic-password
# S3 credentials belong only on the backup host, not in the web process.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Separate disposable database, never production. Weekly restore check only.
RESTORE_TEST_DATABASE_URL=postgresql+psycopg://restore_admin:CHANGE_ME@127.0.0.1:5432/petcare_restore_test
